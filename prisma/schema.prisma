generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MenuItem {
  id        String   @id @default(cuid())
  name      String
  nameZh    String?
  price     Int      // stored in cents
  cat       String
  imageUrl  String?
  available Boolean  @default(true)
  createdAt DateTime @default(now())

  orderItems     OrderItem[]
  modifierGroups MenuItemModifierGroup[]
}

model ModifierGroup {
  id           String   @id @default(cuid())
  name         String
  required     Boolean  @default(false)
  singleSelect Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  options ModifierOption[]
  items   MenuItemModifierGroup[]
}

model ModifierOption {
  id         String        @id @default(cuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int           @default(0)
  isDefault  Boolean       @default(false)
  sortOrder  Int           @default(0)
}

model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  sortOrder       Int           @default(0)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  orderNo           String      @default("000") // daily sequence, SGT, resets at midnight — e.g. "001"
  totalCents        Int
  payment           String      // cash | paynow
  cashReceivedCents Int?        // cash payments only — amount tendered
  orderType         String      @default("dine_in") // dine_in | takeaway
  staffDiscount     Boolean     @default(false)
  status            String      @default("completed") // completed | voided | refunded
  createdAt         DateTime    @default(now())
  deletedAt         DateTime?
  closedAt          DateTime?   // set by "Close Sales" — archived out of the default/today view

  items OrderItem[]
}

model DailyClosing {
  id            String   @id @default(cuid())
  periodStart   DateTime // earliest order included in this closing
  closedAt      DateTime @default(now()) // when the closing was run (~ latest order covered)
  orderCount    Int      // completed orders only
  totalCents    Int      // completed orders only
  cashCents     Int
  paynowCents   Int
  voidedCount   Int
  refundedCount Int
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  name       String   // snapshot at time of sale
  quantity   Int
  unitCents  Int
  modifiers  String?  // JSON: SelectedModifier[]
}
